# Kernel config fragment for the minimal hermes appliance.
#
# UNTESTED. Merge onto `make tinyconfig` and build; see boot/kernel/README.md.
# Each symbol below traces to something the recorded turn actually exercised —
# no symbol is here "because kernels usually have it".
#
#   make tinyconfig
#   scripts/kconfig/merge_config.sh .config boot/kernel/minimal.config
#   make -j"$(nproc)" bzImage

# --- base ---------------------------------------------------------------
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y

# --- boot ---------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_KERNEL_XZ=y

# --- process + syscall surface the agent uses ---------------------------
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_MEMBARRIER=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# --- filesystems --------------------------------------------------------
# FILE_LOCKING is not optional: SQLite takes fcntl(F_SETLK) on state.db, and
# hermes_cli/config.py:942 fails on every load_config() without a writable,
# lockable $HERMES_HOME.
CONFIG_FILE_LOCKING=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVPTS_FS=y
# Persistent state. Drop these (and the block drivers below) if you accept a
# RAM-only rootfs and losing the transcript at every power cycle.
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y

# --- storage (bare metal; drop for netboot/initramfs-only) --------------
CONFIG_BLK_DEV_NVME=y
CONFIG_SATA_AHCI=y

# --- network ------------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
# AF_UNIX is required whenever any tool is advertised: code_execution_tool.py
# opens a unix socket for sandbox RPC on POSIX (loopback TCP is the Windows
# path). Dropping it breaks tool turns, not just the sandbox.
CONFIG_UNIX=y
# No IPv6: the appliance reaches exactly one endpoint. Re-enable if that
# endpoint is v6-only.
# CONFIG_IPV6 is not set
# Pick the driver for your board. e1000e is the cheapest real-hardware case;
# virtio-net if this is a VM. Server NICs (i40e/ice/bnxt/mlx5) cost more and
# may pull a firmware blob this ledger does not price.
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y

# --- clock + entropy ----------------------------------------------------
# TLS certificate validity needs a correct wall clock; without an RTC the SNTP
# one-shot in the initramfs must run before the first handshake.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
# Without this (or an HWRNG) OpenSSL's blocking getrandom stalls the first
# handshake for minutes on a headless board. It reads as a hang, not an error.
CONFIG_RANDOM_TRUST_CPU=y

# --- console ------------------------------------------------------------
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- explicitly NOT enabled --------------------------------------------
# Nothing on the turn path needs containers, cgroups, seccomp, ptrace,
# netfilter, or a swap device. If you add the docker/sandbox toolsets back,
# NAMESPACES + CGROUPS return and the kernel grows accordingly.
# CONFIG_NAMESPACES is not set
# CONFIG_CGROUPS is not set
# CONFIG_SECCOMP is not set
# CONFIG_SWAP is not set
# CONFIG_MODULES is not set
